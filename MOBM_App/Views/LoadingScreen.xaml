<Window x:Class="MOBM_App.Views.LoadingScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOBM"
        Width="500" Height="300"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#1E1E1E" CornerRadius="15" BorderBrush="#2979FF" BorderThickness="2">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Логотип -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="MOBM" FontSize="48" FontWeight="Bold" 
                           Foreground="#00E676" HorizontalAlignment="Center"/>
                <TextBlock Text="Система управления мебельным бизнесом" FontSize="14" 
                           Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Прогресс -->
            <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="8" 
                         Background="#2C2C2C" Foreground="#00E676" 
                         BorderThickness="0" Margin="0,20,0,20"
                         Maximum="100" Minimum="0" Value="0"/>

            <!-- Статус -->
            <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="Загрузка..." FontSize="14" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        </Grid>
    </Border>
</Window>