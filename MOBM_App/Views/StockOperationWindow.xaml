<Window x:Class="MOBM_App.Views.StockOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операция со складом" 
        Height="624" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#1E1E1E" CornerRadius="20" BorderThickness="2">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="BorderColor" Color="#00E676"/>
        </Border.BorderBrush>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Иконка и заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="60" Height="60" CornerRadius="15" Margin="0,0,20,0">
                    <Border.Background>
                        <SolidColorBrush x:Name="IconBgColor" Color="#00E676"/>
                    </Border.Background>
                    <TextBlock x:Name="TxtIcon" Text="📥" FontSize="32" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Приход товара" 
                               FontSize="24" FontWeight="Bold" Foreground="White"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtProductName" Text="Древесина сосна" 
                               FontSize="16" Foreground="#B0B0B0"/>
                </StackPanel>
            </Grid>

            <!-- Информация об остатке -->
            <Border Grid.Row="1" Background="#2C2C2C" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Текущий остаток на складе:" 
                                   Foreground="#B0B0B0" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtCurrentStock" Text="1000 шт." 
                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#3C3C3C" CornerRadius="8" Padding="15,10">
                        <TextBlock x:Name="TxtOperationType" Text="ПРИХОД" 
                                   FontSize="14" FontWeight="Bold" Foreground="#00E676"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Поле ввода количества -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Количество:" FontSize="14" Foreground="White" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtQuantity" Padding="15,12" FontSize="18"
                         Background="#2C2C2C" Foreground="White" 
                         BorderBrush="#444" BorderThickness="2"
                         TextChanged="TxtQuantity_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="CaretBrush" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#00E676"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock x:Name="TxtNewStock" Text="Новый остаток: 1000 шт." 
                           FontSize="13" Foreground="#00E676" Margin="0,8,0,0" FontWeight="Bold"/>
            </StackPanel>

            <!-- Комментарий -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Комментарий (необязательно):" 
                           FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtComment" Padding="12,10" FontSize="13"
                         Background="#2C2C2C" Foreground="White" 
                         BorderBrush="#444" BorderThickness="1"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                         VerticalAlignment="Top"/>
            </StackPanel>

            <!-- Подсказка -->
            <Border Grid.Row="4" Background="#263238" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <TextBlock x:Name="TxtHint" 
                           Text="💡 Приход увеличивает остаток на складе. Используйте при получении товара от поставщика."
                           FontSize="12" Foreground="#78909C" TextWrapping="Wrap"/>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Background="#FF1744" Foreground="White"
                        Padding="25,12" Margin="0,0,15,0" Cursor="Hand"
                        FontSize="14" BorderThickness="0"
                        Width="120"/>
                <Button x:Name="BtnConfirm" Content="📥 Оприходовать" Click="BtnConfirm_Click"
                        Background="#00E676" Foreground="White"
                        Padding="25,12" Cursor="Hand"
                        FontSize="14" BorderThickness="0"
                        Width="180" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>