<Window x:Class="MOBM_App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе MOBM" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="30">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="MOBM" FontSize="48" FontWeight="Bold" 
                       Foreground="#00E676" HorizontalAlignment="Center"/>
            <TextBlock Text="Система управления мебельным бизнесом" 
                       FontSize="16" Foreground="#B0B0B0" 
                       HorizontalAlignment="Center" Margin="0,10,0,30"/>

            <Border Background="#2C2C2C" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Версия: 1.0.0" FontSize="14" Margin="0,5"/>
                    <TextBlock Text="Разработчик: Жуковский Владисалав Александрович" FontSize="14" Margin="0,5"/>
                    <TextBlock Text="Группа: 81ТП" FontSize="14" Margin="0,5" Width="352"/>
                    <TextBlock Text="Год: 2026" FontSize="14" Margin="0,5"/>
                    <Separator Margin="0,10" Background="#444"/>
                    <TextBlock Text="Технологии:" FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBlock Text="• C# / WPF / .NET Framework 4.8" FontSize="13" Foreground="#B0B0B0" Margin="0,3"/>
                    <TextBlock Text="• SQLite (база данных)" FontSize="13" Foreground="#B0B0B0" Margin="0,3"/>
                    <TextBlock Text="• MVVM паттерн" FontSize="13" Foreground="#B0B0B0" Margin="0,3"/>
                    <TextBlock Text="• LiveCharts (графики)" FontSize="13" Foreground="#B0B0B0" Margin="0,3"/>
                </StackPanel>
            </Border>

            <Button Content="Закрыть" Click="BtnClose_Click"
                    Background="#2979FF" Foreground="White"
                    Padding="30,12,30,12" Margin="0,30,0,0" Cursor="Hand"
                    FontSize="14" BorderThickness="0"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>