<Window x:Class="MOBM_App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MOBM_App.Views"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        Title="MOBM - Система управления мебельным бизнесом" 
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        KeyDown="Window_KeyDown">

    <Window.InputBindings>
        <KeyBinding Key="F" Command="{x:Static input:ApplicationCommands.Find}" Modifiers="Control"/>
        <KeyBinding Key="S" Command="{x:Static input:ApplicationCommands.Save}" Modifiers="Control"/>
        <KeyBinding Key="N" Command="{x:Static input:ApplicationCommands.New}" Modifiers="Control"/>
        <KeyBinding Key="Escape" Command="{x:Static input:ApplicationCommands.Close}"/>
        <KeyBinding Key="F1" Command="{x:Static input:ApplicationCommands.Help}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Find}" Executed="Find_Executed"/>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Save}" Executed="Save_Executed"/>
        <CommandBinding Command="{x:Static input:ApplicationCommands.New}" Executed="New_Executed"/>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Close}" Executed="Close_Executed"/>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Help}" Executed="Help_Executed"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Боковое меню слева -->
        <Border Grid.Column="0" Background="#2C2C2C" CornerRadius="15,0,0,15" Padding="15,30,15,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="MOBM" FontSize="32" FontWeight="Bold" 
                               Foreground="#00E676" HorizontalAlignment="Center"/>
                    <TextBlock Text="Система управления" FontSize="11" 
                               Foreground="#B0B0B0" HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Кнопки меню -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel VerticalAlignment="Top">
                        <Button x:Name="BtnCatalog" Content="🏠 ГЛАВНАЯ (МЕБЕЛЬ)" 
                                Click="NavCatalog_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Каталог товаров (F5)"/>

                        <Button x:Name="BtnOrder" Content="🛒 ТЕКУЩИЙ ЗАКАЗ" 
                                Click="NavCurrentOrder_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Оформить новый заказ (Ctrl+N)"/>

                        <Button x:Name="BtnWarehouse" Content="📦СКЛАД (СЫРЬЁ)" 
                                Click="NavWarehouse_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Управление складом сырья"/>

                        <Button x:Name="BtnHistory" Content="📋 ИСТОРИЯ ЗАКАЗОВ" 
                                Click="NavHistory_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Архив заказов"/>

                        <Button x:Name="BtnDashboard" Content="💼ДАШБОРД" 
                                Click="NavDashboard_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Статистика и графики"/>

                        <Button x:Name="BtnEmployeeRequests" Content="👥 ЗАЯВКИ СОТРУДНИКОВ" 
                                Click="NavEmployeeRequests_Click" 
                                Style="{StaticResource MenuButton}"
                                ToolTip="Рассмотрение заявок на трудоустройство"
                                Visibility="Collapsed"/>
                        <!-- НОВАЯ КНОПКА: Управление пользователями (только для админа) -->
                        <Button x:Name="BtnUsersManagement" Content="👤 ПОЛЬЗОВАТЕЛИ" 
        Click="NavUsersManagement_Click" 
        Style="{StaticResource MenuButton}"
        ToolTip="Управление профилями пользователей (только для администратора)"
        Visibility="Collapsed"/>
                        <!-- НОВАЯ КНОПКА: Промокоды (только для админа) -->
                        <Button x:Name="BtnPromoCodes" Content="🎫 ПРОМОКОДЫ" 
        Click="NavPromoCodes_Click" 
        Style="{StaticResource MenuButton}"
        ToolTip="Управление промокодами и скидками (только для администратора)"
        Visibility="Collapsed"/>
                    </StackPanel>
                    
                </ScrollViewer>
                


                <!-- Нижние кнопки -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Separator Background="#444" Margin="0,0,0,15"/>

                    <Button Content="❓ Справка" Click="Help_Click" 
                            Style="{StaticResource MenuButton}"
                            Foreground="#B0B0B0" FontSize="12" Padding="20,10"
                            ToolTip="Справка (F1)"/>

                    <Button Content="ℹ️ О программе" Click="About_Click" 
                            Style="{StaticResource MenuButton}"
                            Foreground="#B0B0B0" FontSize="12" Padding="20,10"
                            ToolTip="О программе MOBM"/>

                    <Button Content="🚪 Выйти" Click="Logout_Click" 
                            Background="#FF1744" Foreground="White"
                            Padding="20,12" Margin="0,0,0,0"
                            FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand" BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            ToolTip="Выйти из системы (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF1744"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D50000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ✅ Основной контент справа — обернут в ScrollViewer для адаптивности -->
        <Border Grid.Column="1" Background="#1E1E1E" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </ScrollViewer>
        </Border>

        <!-- Строка состояния внизу -->
        <views:StatusBarControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                                x:Name="AppStatusBar"/>
    </Grid>
</Window>