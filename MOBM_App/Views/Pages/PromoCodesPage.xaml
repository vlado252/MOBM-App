<Page x:Class="MOBM_App.Views.Pages.PromoCodesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление промокодами">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка добавления -->
        <Border Background="#2C2C2C" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="🎫 Управление промокодами" FontSize="20" FontWeight="Bold" 
                               Foreground="#00E676"/>
                    <TextBlock Text="Создание, редактирование и удаление промокодов (только для администратора)" 
                               FontSize="12" Foreground="#B0B0B0" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="➕ Добавить промокод" Click="AddPromo_Click"
                            Background="#2979FF" Foreground="White" Padding="15,8" Margin="0,0,10,0"
                            BorderThickness="0" Cursor="Hand"/>

                    <Button Content="🔄 Обновить" Click="Refresh_Click"
                            Background="#FF9100" Foreground="White" Padding="15,8"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица промокодов -->
        <Border Grid.Row="1" Background="#2C2C2C" CornerRadius="10" Padding="5">
            <DataGrid x:Name="PromoGrid" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="#1E1E1E" Foreground="White"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#444"
                      RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="150"/>
                    <DataGridTextColumn Header="Скидка (%)" Binding="{Binding DiscountPercent}" Width="100"/>
                    <DataGridTextColumn Header="Действует до" Binding="{Binding ValidUntil, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    <DataGridTemplateColumn Header="Действия" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️ Изменить" Click="Edit_Click"
                                            Background="#2979FF" Foreground="White"
                                            Padding="8,4" Margin="0,0,5,0"
                                            BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                    <Button Content="🗑️ Удалить" Click="Delete_Click"
                                            Background="#FF1744" Foreground="White"
                                            Padding="8,4"
                                            BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>