<Page x:Class="MOBM_App.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">
	<Border Background="#1E1E1E" CornerRadius="10" Padding="30" MaxWidth="400" VerticalAlignment="Center">
		<StackPanel>
			<TextBlock Text="ЛИЧНЫЙ КАБИНЕТ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<TextBlock Text="ФИО:" Foreground="#B0B0B0"/>
			<TextBlock x:Name="TxtName" FontSize="16" Margin="0,0,0,15"/>

			<TextBlock Text="Email:" Foreground="#B0B0B0"/>
			<TextBlock x:Name="TxtEmail" FontSize="16" Margin="0,0,0,15"/>

			<TextBlock Text="Роль:" Foreground="#B0B0B0"/>
			<TextBlock x:Name="TxtRole" FontSize="16" Foreground="#00E676" Margin="0,0,0,30"/>

			<Button Content="Сменить пароль" Style="{StaticResource ActionBtn}" Background="#AA00FF" Margin="0,0,0,10"/>
			<Button Content="Выйти из аккаунта" Style="{StaticResource ActionBtn}" Background="#FF1744" Click="Logout_Click"/>
		</StackPanel>
	</Border>
</Page>