<Page x:Class="MOBM_App.Views.Pages.EmployeeRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заявки на трудоустройство">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C2C2C" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="📋 ЗАЯВКИ НА ТРУДОУСТРОЙСТВО" FontSize="24" FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Рассмотрение заявок от кандидатов" FontSize="13" 
                               Foreground="#B0B0B0" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TxtTotalRequests" Text="Всего заявок: 0" FontSize="14" 
                               Foreground="#00E676" Margin="0,10,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Обновить" Click="BtnRefresh_Click"
                        Background="#2979FF" Foreground="White"
                        Padding="20,12" Cursor="Hand" BorderThickness="0"
                        FontSize="14"/>
            </Grid>
        </Border>

        <!-- Список заявок -->
        <Border Grid.Row="1" Background="#2C2C2C" CornerRadius="10" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RequestsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Номер заявки -->
                                    <Border Background="#2979FF" CornerRadius="8" Padding="15,10" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Id}" FontSize="24" FontWeight="Bold" 
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Основная информация -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,20,0">
                                        <TextBlock Text="{Binding Position}" FontSize="18" FontWeight="Bold" 
                                                   Foreground="White" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="👤 " Foreground="#B0B0B0"/>
                                            <TextBlock Text="{Binding FullName}" Foreground="#E0E0E0" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="📧 " Foreground="#B0B0B0"/>
                                            <TextBlock Text="{Binding Email}" Foreground="#E0E0E0" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="📱 " Foreground="#B0B0B0"/>
                                            <TextBlock Text="{Binding Phone}" Foreground="#E0E0E0" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅 " Foreground="#B0B0B0"/>
                                            <TextBlock Text="{Binding SubmittedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                                       Foreground="#E0E0E0" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Кнопка и статус -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{Binding StatusColor}" CornerRadius="6" Padding="10,5" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="White" 
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Content="👁️ Просмотреть" Click="BtnViewRequest_Click"
                                                Background="#00E676" Foreground="White"
                                                Padding="15,10" Cursor="Hand" BorderThickness="0"
                                                FontSize="13" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>