<Page x:Class="MOBM_App.Views.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MOBM_App.ViewModels"
      Title="Каталог мебели">
    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" 
         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
         ToolTip="Поиск по названию..."/>

                <TextBlock Grid.Column="2" Text=" Категория:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox Grid.Column="3" SelectedIndex="0" SelectionChanged="CategoryFilter_SelectionChanged">
                    <ComboBoxItem Content="Все категории" Tag="-1"/>
                    <ComboBoxItem Content="Мебель" Tag="0"/>
                    <ComboBoxItem Content="Сырьё" Tag="1"/>
                </ComboBox>

                <Button Grid.Column="5" x:Name="BtnAddProduct" Content="➕ Добавить товар" 
                        Style="{StaticResource ActionBtn}" Background="#2979FF" 
                        Click="AddProduct_Click" Margin="0,0,10,0"
                        ToolTip="Добавить новый товар в каталог (только для администратора и менеджера)"/>

                <Button Grid.Column="6" Content="+ Добавить в заказ" Style="{StaticResource ActionBtn}"
                        Background="{StaticResource BtnGreen}" Click="AddToOrder_Click"
                        ToolTip="Добавить выбранный товар в текущий заказ"/>
            </Grid>
        </Border>

        <!-- Таблица товаров -->
        <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="5" Grid.Row="1">
            <DataGrid x:Name="ProductsGrid" 
          ItemsSource="{Binding FilteredProducts}"
          AutoGenerateColumns="False"
          CanUserSortColumns="True" 
          HeadersVisibility="Column" 
          SelectionMode="Single"
          Background="{StaticResource BgMain}" 
          Foreground="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="На складе" Binding="{Binding Stock}" Width="100"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>