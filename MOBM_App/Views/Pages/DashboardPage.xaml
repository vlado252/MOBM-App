<Page x:Class="MOBM_App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Дашборд">

    <!-- ScrollViewer с прокруткой колесом (работает по умолчанию в WPF) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📊 Дашборд" FontSize="28" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,20"/>

            <!-- Статистика -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#2C2C2C" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Всего заказов" Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtTotalOrders" Text="0" FontSize="32" 
                                   FontWeight="Bold" Foreground="#2979FF"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2C2C2C" CornerRadius="10" 
                        Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Выручка" Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtRevenue" Text="0 BYN" FontSize="32" 
                                   FontWeight="Bold" Foreground="#00E676"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2C2C2C" CornerRadius="10" 
                        Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Товаров в каталоге" Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtProducts" Text="0" FontSize="32" 
                                   FontWeight="Bold" Foreground="#FF9100"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#2C2C2C" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Пользователей" Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtUsers" Text="0" FontSize="32" 
                                   FontWeight="Bold" Foreground="#AA00FF"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- График заказов по дням -->
            <Border Grid.Row="1" Background="#2C2C2C" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📈 Заказы по дням" FontSize="18" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,15"/>
                    <lvc:CartesianChart x:Name="OrdersChart" Height="250">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Дата" Foreground="White"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество" Foreground="White"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- Круговая диаграмма и топ товаров -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#2C2C2C" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📊 Распределение по категориям" FontSize="18" 
                                   FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <lvc:PieChart x:Name="CategoryChart" Height="250"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2C2C2C" CornerRadius="10" 
                        Padding="20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📊 Топ товаров по продажам" FontSize="18" 
                                   FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <lvc:CartesianChart x:Name="TopProductsChart" Height="250">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis LabelsRotation="45" Foreground="White"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Продано шт." Foreground="White"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>