<Window x:Class="MOBM_App.Views.RegistrationPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация сотрудника - MOBM" 
        Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30,20,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="📝 ЗАЯВКА НА ТРУДОУСТРОЙСТВО" FontSize="20" FontWeight="Bold" 
                           Foreground="#00E676" HorizontalAlignment="Center"/>
                <TextBlock Text="Заполните форму для подачи заявки на работу" FontSize="12" 
                           Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="ФИО полностью:" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtFullName" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Желаемый логин:" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLogin" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль:" FontSize="13" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Padding="12,10" FontSize="14"
                             Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                             BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Email:" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEmail" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Телефон:" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPhone" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Желаемая должность:" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPosition" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

                <TextBlock Text="Желаемая роль в системе:" FontSize="13" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbRole" Padding="12,10" FontSize="14"
                          Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                          BorderThickness="1" Margin="0,0,0,20">
                    <ComboBoxItem Content="📦 Кладовщик" Tag="2" IsSelected="True"/>
                    <ComboBoxItem Content="💼 Менеджер" Tag="1"/>
                </ComboBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Отмена" Click="BtnCancel_Click"
                            Background="#FF1744" Foreground="White"
                            Padding="20,12" Margin="0,0,10,0" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>

                    <Button Grid.Column="1" Content="Отправить заявку" Click="BtnSubmit_Click"
                            Background="#00E676" Foreground="White"
                            Padding="20,12" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>