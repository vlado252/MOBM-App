<Window x:Class="MOBM_App.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" 
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка чека -->
        <Border Background="#2C2C2C" CornerRadius="10" Padding="20,20,20,20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ЧЕК ЗАКАЗА" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Номер заказа:" Foreground="#B0B0B0" FontSize="12"/>
                        <TextBlock x:Name="TxtOrderId" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Дата:" Foreground="#B0B0B0" FontSize="12"/>
                        <TextBlock x:Name="TxtOrderDate" FontSize="16"/>
                    </StackPanel>
                </Grid>
                <Separator Margin="0,10,0,10" Background="#444"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Оформил:" Foreground="#B0B0B0" FontSize="12"/>
                        <TextBlock x:Name="TxtUserName" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Статус:" Foreground="#B0B0B0" FontSize="12"/>
                        <TextBlock x:Name="TxtStatus" FontSize="14" Foreground="#00E676"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Таблица товаров -->
        <Border Background="#2C2C2C" CornerRadius="10" Padding="10,10,10,10" Grid.Row="1">
            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="#1E1E1E" Foreground="White"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#444"
                      RowBackground="#1E1E1E" AlternatingRowBackground="#252525">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итого и кнопки -->
        <Border Background="#2C2C2C" CornerRadius="10" Padding="20,20,20,20" Grid.Row="2" Margin="0,15,0,0">
            <StackPanel>
                <!-- Итоговая сумма сверху -->
                <StackPanel HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="ИТОГО:" Foreground="#B0B0B0" FontSize="14"/>
                    <TextBlock x:Name="TxtTotal" FontSize="32" FontWeight="Bold" 
                               Foreground="#00E676"/>
                </StackPanel>

                <!-- Кнопки снизу -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📄 Текстовый чек" Click="BtnTextReceipt_Click"
                            Background="#AA00FF" Foreground="White"
                            Padding="20,12,20,12" Margin="0,0,10,0" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>
                    <Button Content="🖨️ Печать" Click="BtnPrint_Click"
                            Background="#FF9100" Foreground="White"
                            Padding="20,12,20,12" Margin="0,0,10,0" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>
                    <Button Content="📧 Отправить по почте" Click="BtnEmail_Click"
                            Background="#2979FF" Foreground="White"
                            Padding="20,12,20,12" Margin="0,0,10,0" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>
                    <Button Content="Закрыть" Click="BtnClose_Click"
                            Background="#FF1744" Foreground="White"
                            Padding="20,12,20,12" Cursor="Hand"
                            FontSize="14" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>