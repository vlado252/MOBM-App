<UserControl x:Class="MOBM_App.Views.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30">
    <Border Background="#2C2C2C" BorderBrush="#444" BorderThickness="0,1,0,0">
        <Grid Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Пользователь -->
            <TextBlock x:Name="TxtUser" Text="👤 Пользователь" 
                       Grid.Column="0"
                       Foreground="#2979FF" VerticalAlignment="Center" 
                       FontSize="12" Margin="0,0,25,0"/>

            <!-- Роль -->
            <TextBlock x:Name="TxtRole" Text="🔑 Роль" 
                       Grid.Column="1"
                       Foreground="#00E676" VerticalAlignment="Center" 
                       FontSize="12" Margin="0,0,25,0"/>

            <!-- Дата/время -->
            <TextBlock x:Name="TxtDateTime" Text="01.01.2026 12:00:00" 
                       Grid.Column="2"
                       Foreground="#B0B0B0" VerticalAlignment="Center" 
                       FontSize="12" Margin="0,0,25,0"/>

            <!-- Статус (справа) -->
            <TextBlock Grid.Column="3" x:Name="TxtStatus" Text="Готово" 
                       Foreground="#B0B0B0" VerticalAlignment="Center" 
                       FontSize="12"/>
        </Grid>
    </Border>
</UserControl>