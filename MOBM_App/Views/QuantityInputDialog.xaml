<Window x:Class="MOBM_App.Views.QuantityInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление в заказ" 
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок товара -->
        <TextBlock x:Name="TxtTitle" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" TextWrapping="Wrap" Grid.Row="0"/>

        <!-- Информация об остатке -->
        <TextBlock x:Name="TxtInfo" Foreground="#B0B0B0" FontSize="14" Margin="0,0,0,24" TextWrapping="Wrap" Grid.Row="1"/>

        <!-- Поле ввода -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Введите количество:" FontSize="14" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtQuantity" 
                     Padding="12,10" FontSize="16"
                     Background="#2C2C2C" Foreground="White"
                     BorderBrush="#444" BorderThickness="1"
                     KeyDown="TxtQuantity_KeyDown"/>
        </StackPanel>

        <!-- Пустая строка для растягивания -->
        <Grid Grid.Row="3"/>

        <!-- Кнопки внизу -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4" Margin="0,10,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click"
                    Background="#FF1744" Foreground="White"
                    Padding="24,12" Margin="0,0,16,0" Cursor="Hand"
                    FontSize="14" BorderThickness="0"/>

            <Button Content="Добавить" Click="BtnOk_Click"
                    Background="#00E676" Foreground="White"
                    Padding="24,12" Cursor="Hand"
                    FontSize="14" BorderThickness="0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>