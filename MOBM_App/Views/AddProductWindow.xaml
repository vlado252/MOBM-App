<Window x:Class="MOBM_App.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление нового товара" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="НОВЫЙ ТОВАР" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название товара:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtName" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1"/>

                <TextBlock Text="Категория:" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" Padding="10,8" Margin="0,0,0,15"
                          Background="#2C2C2C" Foreground="White"
                          BorderBrush="#444" BorderThickness="1">
                    <ComboBoxItem Content="Мебель" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="Сырьё" Tag="1"/>
                </ComboBox>

                <TextBlock Text="Цена (BYN):" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPrice" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1"/>

                <TextBlock Text="Количество на складе:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtStock" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1"/>

                <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDescription" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Материал:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtMaterial" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1"/>

                <TextBlock Text="Габариты:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDimensions" Padding="10,8" Margin="0,0,0,15"
                         Background="#2C2C2C" Foreground="White"
                         BorderBrush="#444" BorderThickness="1"
                         ToolTip="Например: 50x50x100"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click"
                    Background="#FF1744" Foreground="White"
                    Padding="20,12,20,12" Margin="0,0,10,0" Cursor="Hand"
                    FontSize="14" BorderThickness="0"/>
            <Button Content="Добавить" Click="BtnAdd_Click"
                    Background="#00E676" Foreground="White"
                    Padding="20,12,20,12" Cursor="Hand"
                    FontSize="14" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>