<Window x:Class="MOBM_App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка MOBM" Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📖 Справка по системе MOBM" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="⌨️ Горячие клавиши:" FontSize="16" FontWeight="Bold" 
                           Foreground="#00E676" Margin="0,10,0,10"/>
                <TextBlock Text="• F5 — Обновить данные" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Ctrl+F — Поиск" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Ctrl+S — Сохранить" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Ctrl+N — Новый заказ" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Esc — Закрыть окно" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• F1 — Справка" FontSize="14" Margin="10,5"/>

                <TextBlock Text="👥 Роли пользователей:" FontSize="16" FontWeight="Bold" 
                           Foreground="#00E676" Margin="0,20,0,10"/>
                <TextBlock Text="• Администратор — полный доступ ко всем функциям" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Менеджер — каталог, заказы, просмотр склада" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Кладовщик — склад, приход/расход, просмотр заказов" FontSize="14" Margin="10,5"/>

                <TextBlock Text=" Основные разделы:" FontSize="16" FontWeight="Bold" 
                           Foreground="#00E676" Margin="0,20,0,10"/>
                <TextBlock Text="• Каталог — просмотр и поиск товаров, добавление в заказ" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Текущий заказ — оформление нового заказа" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Склад — управление сырьём (приход/расход)" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• История заказов — архив выполненных заказов" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Дашборд — статистика и графики" FontSize="14" Margin="10,5"/>

                <TextBlock Text=" Советы:" FontSize="16" FontWeight="Bold" 
                           Foreground="#00E676" Margin="0,20,0,10"/>
                <TextBlock Text="• Используйте фильтр по категориям для быстрого поиска" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Отмечайте 'Только низкий остаток' для контроля склада" FontSize="14" Margin="10,5"/>
                <TextBlock Text="• Экспортируйте историю заказов в Excel для отчётов" FontSize="14" Margin="10,5"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Click="BtnClose_Click"
                Background="#2979FF" Foreground="White"
                Padding="30,12,30,12" Margin="0,20,0,0" Cursor="Hand"
                FontSize="14" BorderThickness="0"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>