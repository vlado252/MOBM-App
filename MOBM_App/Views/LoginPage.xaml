<Window x:Class="MOBM_App.Views.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOBM - Вход в систему" 
        Height="537" Width="400"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Логотип -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock Text="MOBM" FontSize="48" FontWeight="Bold" 
                       Foreground="#00E676" HorizontalAlignment="Center"/>
            <TextBlock Text="Система управления мебельным бизнесом" FontSize="12" 
                       Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Заголовок -->
        <TextBlock Grid.Row="1" Text="ВХОД В СИСТЕМУ" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <!-- Логин -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Логин:" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Padding="12,10" FontSize="14"
                     Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                     BorderThickness="1"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Пароль:" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="12,10" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1"
                         KeyDown="TxtPassword_KeyDown"/>
        </StackPanel>

        <!-- Кнопка входа -->
        <Button Grid.Row="4" Content="🔑 Войти" Click="BtnLogin_Click"
                Background="#2979FF" Foreground="White"
                Padding="20,12" Cursor="Hand"
                FontSize="15" FontWeight="SemiBold" BorderThickness="0"
                Margin="0,0,0,15"/>

        <!-- Кнопка регистрации -->
        <Button Grid.Row="5" Content="📝 Подать заявку на работу" Click="BtnRegistration_Click"
                Background="Transparent" Foreground="#2979FF"
                Padding="15,10" Cursor="Hand"
                FontSize="13" BorderThickness="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>