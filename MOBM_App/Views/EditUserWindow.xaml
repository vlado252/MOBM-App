<Window x:Class="MOBM_App.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя" 
        Height="594" Width="469"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize"
        Icon="/Resources/icon.ico">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✏️ Редактирование профиля" FontSize="20" FontWeight="Bold" 
                       Foreground="#00E676" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtUserId" Text="ID: " FontSize="12" 
                       Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Логин:" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Padding="10,8" FontSize="14"
                     Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                     BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="10,8" FontSize="14"
                         Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                         BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="ФИО:" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Padding="10,8" FontSize="14"
                     Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                     BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Email:" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtEmail" Padding="10,8" FontSize="14"
                     Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                     BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Роль в системе:" FontSize="13" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbRole" Padding="10,8" FontSize="14"
                      Background="#2C2C2C" Foreground="White" BorderBrush="#444"
                      BorderThickness="1">
                <ComboBoxItem Content="👑 Администратор" Tag="0"/>
                <ComboBoxItem Content="💼 Менеджер" Tag="1"/>
                <ComboBoxItem Content="📦 Кладовщик" Tag="2"/>
            </ComboBox>
        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Отмена" Click="Cancel_Click"
                    Background="#FF1744" Foreground="White"
                    Padding="15,10" Margin="0,0,10,0" Cursor="Hand"
                    FontSize="14" BorderThickness="0"/>

            <Button Grid.Column="1" Content="💾 Сохранить" Click="Save_Click"
                    Background="#00E676" Foreground="White"
                    Padding="15,10" Cursor="Hand"
                    FontSize="14" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>